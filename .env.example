# Copy to .env (gitignored) and fill in what you use.
GRAFANA_PASSWORD=change-me
# Alerts: set Telegram OR a webhook (Discord/Slack-compatible). With neither, alerts print to the log.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#ALERT_WEBHOOK_URL=
# Show Grafana/Prometheus to other machines (default: localhost only)
#BIND=0.0.0.0
